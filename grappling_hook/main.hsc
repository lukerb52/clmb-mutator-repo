; Native HS grapple: all gameplay math lives here, not in the host.
; Per-player long fields: 0 active, 1 attached, 2 armed, 3 cooldown,
; 4 target, 5 moved(+1; zero means none), 6 head(+1), 7 rope(+1),
; 8 shown generation, 9 hook generation, 10 initialized.
; Real fields: 0..2 point, 3..5 flight velocity, 6 flown,
; 7 length, 8..10 target-relative offset. Scratch globals are callback-local
; in effect: the host serializes callbacks, never recursively invoking HS.
(global long p 0)
(global long u -1)
(global long target -1)
(global long parent -1)
(global long moved -1)
(global long head -1)
(global long rope -1)
(global real x 0)
(global real y 0)
(global real z 0)
(global real ux 0)
(global real uy 0)
(global real uz 0)
(global real vx 0)
(global real vy 0)
(global real vz 0)
(global real dx 0)
(global real dy 0)
(global real dz 0)
(global real distance 0)
(global real length 0)
(global real mass 1)
(global real factor 0)
(global real ahead 0)
(global real pace 0)
(global boolean wanted false)
(global boolean pressed false)
(global boolean was_pressed false)
(global boolean seen false)
(global boolean first_person false)
(global boolean valid false)
(global long asked_at 0)
(global long last_time 0)
(global boolean rewound false)

(script static void load_point
    (set x (state_get_real p 0)) (set y (state_get_real p 1)) (set z (state_get_real p 2)))
(script static void save_point
    (state_set_real p 0 x) (state_set_real p 1 y) (state_set_real p 2 z))
(script static void unit_position
    (object_position u) (set ux (result_x)) (set uy (result_y)) (set uz (result_z)))
(script static void unit_velocity
    (object_velocity u) (set vx (result_x)) (set vy (result_y)) (set vz (result_z)))
(script static void measure
    (unit_position)
    (set dx (- x ux)) (set dy (- y uy)) (set dz (- z uz))
    (set distance (math_sqrt (+ (* dx dx) (* dy dy) (* dz dz)))))
(script static void hide
    (model_delete (- (state_get_long p 6) 1))
    (model_delete (- (state_get_long p 7) 1))
    (state_set_long p 6 0) (state_set_long p 7 0) (state_set_long p 8 0))
(script static void release_moved
    (set moved (- (state_get_long p 5) 1))
    (if (and (!= moved -1) (object_velocity moved))
        (object_set_velocity moved (* (result_x) 0.5) (* (result_y) 0.5) (* (result_z) 0.5)))
    (state_set_long p 5 0))
(script static void remove_hook
    (if (= (state_get_long p 0) 1)
        (begin
            (if (and (= (state_get_long p 1) 1) (!= u -1))
                (begin (unit_velocity)
                    (set factor (settings_real "release_multiplier"))
                    (object_set_velocity u (* vx factor) (* vy factor) (* vz factor))))
            (state_set_long p 0 0)
            (state_set_long p 3 (settings_real "cooldown"))
            (release_moved))))
(script static void fire
    (unit_position)
    (if (player_aim p)
        (begin
            (set dx (result_x)) (set dy (result_y)) (set dz (result_z))
            (set ahead 0.3) (if (< dz -0.9) (set ahead 0.5))
            (set x (- (+ ux (* dx ahead)) (* dy 0.03)))
            (set y (+ uy (* dy ahead) (* dx 0.03)))
            (set z (+ uz (* dz ahead) (- 0.615 (* (player_crouch p) 0.265))))
            (save_point)
            (set pace (settings_real "projectile_velocity"))
            (state_set_real p 3 (* dx pace)) (state_set_real p 4 (* dy pace))
            (state_set_real p 5 (* dz pace)) (state_set_real p 6 0)
            (state_set_long p 0 1) (state_set_long p 1 0)
            (state_set_long p 4 -1) (state_set_long p 5 0)
            (state_set_long p 9 (+ (state_get_long p 9) 1)))))
(script static void fly
    (if (world_ray x y z (state_get_real p 3) (state_get_real p 4) (state_get_real p 5) u)
        (begin
            (set x (result_x)) (set y (result_y)) (set z (result_z))
            (set target (result_object)) (save_point)
            (state_set_long p 1 1) (state_set_long p 4 target)
            (measure) (state_set_real p 7 distance)
            (if (and (!= target -1) (object_position target))
                (begin
                    (state_set_real p 8 (- x (result_x)))
                    (state_set_real p 9 (- y (result_y)))
                    (state_set_real p 10 (- z (result_z))))))
        (begin
            (set x (+ x (state_get_real p 3))) (set y (+ y (state_get_real p 4)))
            (set z (+ z (state_get_real p 5))) (save_point)
            (state_set_real p 6 (+ (state_get_real p 6) (settings_real "projectile_velocity")))
            (if (>= (state_get_real p 6) (settings_real "range")) (remove_hook)))))
(script static void follow
    (set valid true) (set target (state_get_long p 4))
    (if (!= target -1)
        (if (object_position target)
            (begin
                (set x (+ (result_x) (state_get_real p 8)))
                (set y (+ (result_y) (state_get_real p 9)))
                (set z (+ (result_z) (state_get_real p 10))) (save_point))
            (set valid false))))
(script static void vehicle_factor
    ; Negative is the sentinel: unknown vehicles retain the default zero pull.
    (set factor -1)
    (if (math_equals_string (object_tag parent) "vehicles\banshee\banshee") (set factor 0.07))
    (if (math_equals_string (object_tag parent) "vehicles\c_dropship\c_dropship") (set factor 0))
    (if (math_equals_string (object_tag parent) "vehicles\ghost\ghost") (set factor 0.1))
    (if (math_equals_string (object_tag parent) "vehicles\lifepod\lifepod") (set factor 0))
    (if (math_equals_string (object_tag parent) "vehicles\pelican\pelican") (set factor 0))
    (if (math_equals_string (object_tag parent) "vehicles\warthog\warthog") (set factor 0.1))
    (if (math_equals_string (object_tag parent) "vehicles\scorpion\scorpion") (set factor 0.03))
    (if (math_equals_string (object_tag parent) "vehicles\c gun turret\c gun turret") (set factor 0.35))
    (if (math_equals_string (object_tag parent) "vehicles\wraith\wraith") (set factor 0.07)))
(script static void pull
    (set parent (object_root (state_get_long p 4)))
    (set mass 1)
    (if (math_equals_string (object_kind parent) "weapon") (set mass 0.05))
    (if (or (math_equals_string (object_kind parent) "equipment")
            (math_equals_string (object_kind parent) "garbage")
            (math_equals_string (object_kind parent) "projectile")) (set mass 0))
    (set dz (- dz (settings_real "z_offset")))
    (if (= parent -1) (set dz (+ dz (* (settings_real "z_offset") 2))))
    (set pace (settings_real "speed"))
    (set dx (math_divide dx distance)) (set dy (math_divide dy distance))
    (set dz (math_divide dz distance))
    (unit_velocity)
    (object_set_velocity u (+ vx (* dx pace mass)) (+ vy (* dy pace mass)) (+ vz (* dz pace mass)))
    (if (and (!= parent -1) (game_host))
        (begin
            (set ahead (- 1 mass))
            (if (math_equals_string (object_kind parent) "vehicle")
                (begin (vehicle_factor) (if (>= factor 0) (set ahead factor))))
            (if (math_equals_string (object_kind parent) "biped")
                (set ahead (* (object_acceleration_scale parent) 0.3)))
            (set ahead (* ahead (settings_real "object_multiplier")))
            (if (!= ahead 0)
                (begin
                    (if (and (math_equals_string (object_kind parent) "biped") (= (state_get_long p 5) 0))
                        (begin (if (object_alive parent) (object_turn_around parent))
                            (set ahead (* ahead 5))))
                    (if (= (math_equals_string (object_kind parent) "vehicle") false)
                        (state_set_long p 5 (+ parent 1)))
                    (if (object_velocity parent)
                        (object_set_velocity parent (- (result_x) (* dx pace ahead))
                            (- (result_y) (* dy pace ahead)) (- (result_z) (* dz pace ahead)))))))))
(script static void hold
    (if (and (> distance length) (> distance 0))
        (begin
            (set dx (math_divide dx distance)) (set dy (math_divide dy distance))
            (set dz (math_divide dz distance)) (unit_velocity)
            (set factor (+ (* vx dx) (* vy dy) (* vz dz)))
            (set ahead (min (* (- distance length) 0.3) 0.2))
            (if (< factor 0) (set ahead (- ahead factor)))
            (object_set_velocity u (+ vx (* dx ahead)) (+ vy (* dy ahead)) (+ vz (* dz ahead))))))
(script static void attached
    (follow)
    (if (= valid false) (remove_hook)
        (begin
            (measure) (set length (state_get_real p 7))
            (if (player_button p 2)
                (set length (min (settings_real "range") (+ length (settings_real "let_out_speed"))))
                (set length (max (settings_real "min_distance") (min length distance))))
            (state_set_real p 7 length)
            (if (player_button p 1)
                (if (> distance (settings_real "min_distance")) (pull))
                (begin (release_moved) (hold))))))
(script static void tick
    (set rewound (< (game_time) last_time)) (set last_time (game_time)))
(script static void player_tick
    (set p (game_player_current)) (set u (player_unit p))
    (if rewound
        (begin (state_set_long p 0 0) (state_set_long p 5 0)
            (state_set_long p 2 0) (state_set_long p 3 0)))
    (if (= u -1)
        (begin (state_set_long p 0 0) (state_set_long p 5 0))
        (begin
            (if (= (player_button p 0) false) (state_set_long p 2 1))
            (if (and (= (state_get_long p 0) 1)
                     (or (= (player_button p 0) false) (!= (object_parent u) -1))) (remove_hook))
            (if (> (state_get_long p 3) 0) (state_set_long p 3 (- (state_get_long p 3) 1)))
            (if (and (= (state_get_long p 0) 0) (player_button p 0)
                     (= (state_get_long p 2) 1) (= (state_get_long p 3) 0) (= (object_parent u) -1))
                (begin (fire) (state_set_long p 2 0)))
            (if (= (state_get_long p 0) 1)
                (begin (load_point) (if (= (state_get_long p 1) 0) (fly) (attached)))))))
(script static void frame
    (input_claim (settings_string "controller"))
    (set pressed (or (input_held (settings_string "keyboard")) (input_held (settings_string "controller"))))
    (if (and pressed (= was_pressed false))
        (begin (set wanted (= wanted false)) (set asked_at (game_time)) (set seen false)))
    (set was_pressed pressed)
    (if wanted
        (if (= (state_get_long (player_local_index) 0) 1) (set seen true)
            (if (or seen (< (game_time) asked_at) (> (- (game_time) asked_at) (+ (settings_real "cooldown") 15)))
                (set wanted false))))
    (input_button 0 wanted) (input_button 1 (and wanted (input_jump)))
    (input_button 2 (and wanted (input_crouch))))
(script static void draw_fallback
    (if first_person (draw_line_from_view 0.12 0.1 0.25 x y z 11711154)
        (draw_line ux uy uz x y z 11711154))
    (draw_line (- x 0.04) y z (+ x 0.04) y z 11711154)
    (draw_line x (- y 0.04) z x (+ y 0.04) z 11711154)
    (draw_line x y (- z 0.04) x y (+ z 0.04) 11711154))
(script static void show
    (unit_position) (set uz (+ uz 0.4)) (load_point)
    (if (!= (state_get_long p 8) (state_get_long p 9))
        (begin (hide)
            (state_set_long p 7 (+ (model_create "altis\weapons\grappling_hook\grappling_hook" ux uy uz u) 1))
            (state_set_long p 6 (+ (model_create "altis\weapons\grappling_hook\hook" x y z u) 1))
            (state_set_long p 8 (state_get_long p 9))))
    (set head (- (state_get_long p 6) 1)) (set rope (- (state_get_long p 7) 1))
    (set first_person (and (= p (player_local_index)) (camera_first_person)))
    (if (and (model_exists head) (model_exists rope))
        (begin
            (model_place head x y z)
            (model_forward head (state_get_real p 3) (state_get_real p 4) (state_get_real p 5))
            (model_place rope ux uy uz) (model_node rope 1 x y z)
            (if first_person (model_node_from_view rope 0 0.12 0.1 0.25) (model_node rope 0 ux uy uz))
            (model_face_view rope))
        (draw_fallback)))
(script static void player_frame
    (set p (game_player_current)) (set u (player_unit p))
    (if (and (!= u -1) (= (state_get_long p 0) 1)) (show) (hide)))
(script static void player_stop
    (set p (game_player_current)) (hide))
(script static void stop
    (set wanted false) (set was_pressed false) (set seen false))
